rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net - Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // Strictly enforce that only roha005018@gmail.com with verified email is admin
    function isAdmin() {
      return isSignedIn()
        && request.auth.token.email == 'roha005018@gmail.com'
        && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Admins registry
    match /admins/{adminId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // Menu items: public read, admin-only write
    match /menu/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Categories: public read, admin-only write
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Cafe Settings: public read, admin-only write
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Orders: public create and read, admin-only update and delete
    match /orders/{orderId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // Table Reservations: public create, admin-only read/update/delete
    match /reservations/{reservationId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Inquiries: public create, admin-only read/update/delete
    match /inquiries/{inquiryId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Reviews: public read and create, admin-only delete/update
    match /reviews/{reviewId} {
      allow read, create: if true;
      allow update, delete: if isAdmin();
    }

    // Offers: public read, admin-only write
    match /offers/{offerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Connectivity test collection
    match /test/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
